# Server Configuration
PORT=5000

# MongoDB Configuration
# Default URI for development and production (can be overridden by specific NODE_ENV settings in config.js)
MONGODB_URI=mongodb://mongo:27017/blog_dev
# Specific URI for test environment
MONGODB_URI_TEST=mongodb://mongo:27017/blog_test

# Application Environment
# NODE_ENV can be development, production, or test
NODE_ENV=development

# Optional: Specify service name for logging, if desired
# SERVICE_NAME=BlogApp
